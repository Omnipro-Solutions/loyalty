# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se commitea (ver .gitignore).

# --- Supabase ---
# Proyecto → Project Settings → API, en supabase.com/dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer al cliente ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- SSO (sección 01.3-01.5) ---
# Microsoft Entra ID funciona por OAuth en el plan free de Supabase.
# App registration en https://portal.azure.com — configurar el provider en
# supabase/config.toml [auth.external.azure] o en el dashboard del proyecto.
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
# SAML 2.0 (Okta, Ping, Google Workspace) requiere Supabase Pro. Se deja
# preparado en la UI y detrás de este flag hasta que el proyecto suba de plan.
SSO_SAML_ENABLED=false
